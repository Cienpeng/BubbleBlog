{
    email {$ACME_EMAIL}

    # The production site is proxied by Cloudflare. Only Cloudflare's published
    # networks may supply the client address headers used for rate limiting.
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP X-Forwarded-For
    }
}

# These values belong to Caddy's service environment. Caddy must not read the
# application's .env because that file also contains database and JWT secrets.
{$SITE_ADDRESS} {
    root * {$WEB_ROOT}

    encode zstd gzip

    request_body {
        max_size 6MB
    }

    # This must be a handle block so it runs before the SPA fallback.
    @scanners {
        path /wp-admin* /.env* /phpmyadmin* /.git* /vendor/phpunit*
    }
    handle @scanners {
        respond 404
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        # External HTTPS images are supported by the profile, background,
        # carousel and article features. Only Cloudflare's analytics host is
        # allowed to execute a third-party script.
        Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; frame-ancestors 'none'"
    }

    header /media/* {
        Cache-Control "public, max-age=31536000, immutable"
    }

    @backend {
        path /api/* /media/* /sitemap.xml
    }
    handle @backend {
        reverse_proxy 127.0.0.1:3000 {
            # Pass only Caddy's validated client address to the loopback-bound app.
            header_up X-Forwarded-For {client_ip}
            header_up X-Real-IP {client_ip}
            header_up -CF-Connecting-IP
        }
    }

    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    @datFiles {
        path *.dat
    }
    handle @datFiles {
        header Cache-Control "public, max-age=604800"
        file_server
    }

    handle {
        try_files {path} /index.html
        header Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 20MiB
            roll_keep 5
            roll_keep_for 168h
        }
    }
}
